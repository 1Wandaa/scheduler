# Firebase Configuration — fill in your project's values
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (Required for Firebase AI Logic / Gemini API)
# Get your Site Key from Google reCAPTCHA / Firebase Console -> App Check
VITE_RECAPTCHA_SITE_KEY=
# Provider: 'enterprise' (default) or 'v3'
VITE_RECAPTCHA_PROVIDER=enterprise
# Optional: Set a specific debug token for localhost development
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
