<!DOCTYPE html>
<html xmlns:v="urn:schemas-microsoft-com:vml"
      xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns:m="http://schemas.microsoft.com/office/2004/12/omml"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <title>Faculty Workload - INS F22 Reference</title>
  <!--[if gte mso 9]>
  <xml>
    <w:WordDocument>
      <w:View>Print</w:View>
      <w:Zoom>100</w:Zoom>
      <w:DoNotOptimizeForBrowser/>
    </w:WordDocument>
  </xml>
  <![endif]-->
  <style>
    @page Section1 {
      size: 8.28in 11.71in;
      mso-page-orientation: portrait;
      margin: 0.35in 0.5in 0.4in 0.5in;
      mso-header-margin: 0.35in;
      mso-footer-margin: 0.4in;
      mso-paper-source: 0;
    }
    div.Section1 {
      page: Section1;
      width: 525pt;
      margin: 0 auto;
    }
    body {
      font-family: "Times New Roman", Times, serif;
      font-size: 8pt;
      line-height: 1.15;
      color: #000000;
      background-color: #ffffff;
      margin: 0;
      padding: 0;
    }
    table {
      border-collapse: collapse;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
      width: 525pt;
      table-layout: fixed;
      page-break-inside: avoid;
    }
    .fw-header-table {
      width: 525pt;
      border: 1.0pt solid #000000;
      margin-bottom: 3pt;
    }
    .fw-header-table td {
      border: 1.0pt solid #000000;
      padding: 2pt 4pt;
      font-family: "Times New Roman", Times, serif;
      vertical-align: middle;
    }
    .title-center {
      text-align: center;
      font-weight: bold;
      margin: 3pt 0 2pt 0;
    }
    .fw-table {
      width: 525pt;
      border: 1.0pt solid #000000;
      margin-bottom: 4pt;
    }
    .fw-table th, .fw-table td {
      border: 1.0pt solid #000000;
      padding: 2pt 3pt;
      font-size: 7.5pt;
      font-family: "Times New Roman", Times, serif;
    }
    .fw-table th {
      font-weight: bold;
      text-align: center;
      background: #f2f2f2;
    }
    .sig-table {
      width: 525pt;
      border: none;
      margin-top: 6pt;
    }
    .sig-table td {
      border: none;
      font-size: 7.5pt;
      font-family: "Times New Roman", Times, serif;
      vertical-align: top;
    }
  </style>
</head>
<body>
  <div class="Section1">
    <!-- Header Table (525pt) -->
    <table class="fw-header-table">
      <colgroup>
        <col width="75" style="width: 75pt;">
        <col width="230" style="width: 230pt;">
        <col width="110" style="width: 110pt;">
        <col width="110" style="width: 110pt;">
      </colgroup>
      <tr>
        <td rowspan="4" align="center" style="text-align:center;">
          <b>[LOGO]</b><br><span style="font-size:6.5pt;">CapSU</span>
        </td>
        <td rowspan="2" align="center" style="text-align:center;">
          <div>Document Type: <b>FORM</b></div>
          <div style="font-weight:bold; font-size:8.5pt;">ISO 9001:2015</div>
        </td>
        <td style="font-size:8pt; font-weight:bold; padding-left: 4pt;">Document Code</td>
        <td align="center" style="font-size:8pt; font-weight:bold;">INS F22</td>
      </tr>
      <tr>
        <td style="font-size:8pt; font-weight:bold; padding-left: 4pt;">Revision No.</td>
        <td align="center" style="font-size:8pt; font-weight:bold;">00</td>
      </tr>
      <tr>
        <td rowspan="2" align="center" style="text-align:center;">
          <div style="font-size:8pt;">Document Type:</div>
          <div style="font-size:11.5pt; font-weight:bold; letter-spacing:0.5px;">FACULTY WORKLOAD</div>
        </td>
        <td style="font-size:8pt; font-weight:bold; padding-left: 4pt;">Effective Date</td>
        <td align="center" style="font-size:8pt; font-weight:bold;">August 5, 2024</td>
      </tr>
      <tr>
        <td style="font-size:8pt; font-weight:bold; padding-left: 4pt;">Page</td>
        <td align="center" style="font-size:8pt; font-weight:bold;">1 of 1</td>
      </tr>
    </table>

    <div class="title-center" style="font-size:9.5pt; text-decoration:underline;">
      1st Semester, School Year 2026-2027
    </div>

    <div style="font-size:8.5pt; margin-bottom: 3pt;">
      Name of Faculty: <b><u>PROF. SAMPLE FACULTY</u></b>
    </div>

    <!-- Faculty Profile (525pt: 122 + 45 + 207 + 151) -->
    <table class="fw-table">
      <colgroup>
        <col width="122" style="width: 122pt;">
        <col width="45" style="width: 45pt;">
        <col width="207" style="width: 207pt;">
        <col width="151" style="width: 151pt;">
      </colgroup>
      <thead>
        <tr>
          <th colspan="4" style="background:#e2e8f0; font-weight:bold; font-size: 7.5pt;">FACULTY PROFILE</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td rowspan="3" align="center" valign="middle"><b>BACCALAUREATE</b></td>
          <td>Degree</td>
          <td>BS Computer Science</td>
          <td rowspan="3" valign="middle" align="left" style="padding-left: 4pt;">Rank/Position:<br><b>Associate Professor I</b></td>
        </tr>
        <tr>
          <td>School</td>
          <td>Capiz State University</td>
        </tr>
        <tr>
          <td>Major</td>
          <td>Software Engineering</td>
        </tr>
        <tr>
          <td rowspan="3" align="center" valign="middle"><b>MASTER'S DEGREE</b></td>
          <td>Degree</td>
          <td>Master of Science in Computer Science</td>
          <td rowspan="3" valign="middle" align="left" style="padding-left: 4pt;">Designation:<br><b>Program Coordinator</b></td>
        </tr>
        <tr>
          <td>School</td>
          <td>Iloilo Science and Technology University</td>
        </tr>
        <tr>
          <td>Major</td>
          <td>Networking</td>
        </tr>
      </tbody>
    </table>

    <!-- Teaching Assignments Table (525pt: 72 + 203 + 40 + 90 + 68 + 52) -->
    <p style="font-size: 7.5pt; font-weight: bold; margin: 3pt 0 1pt 0;">TEACHING ASSIGNMENT:</p>
    <table class="fw-table">
      <colgroup>
        <col width="72" style="width: 72pt;">
        <col width="203" style="width: 203pt;">
        <col width="40" style="width: 40pt;">
        <col width="90" style="width: 90pt;">
        <col width="68" style="width: 68pt;">
        <col width="52" style="width: 52pt;">
      </colgroup>
      <thead>
        <tr>
          <th rowspan="2">Course No.</th>
          <th rowspan="2">Course Title</th>
          <th rowspan="2">Units</th>
          <th>No. of Hours</th>
          <th rowspan="2">Course and<br>Year Level</th>
          <th rowspan="2">No. of<br>Students</th>
        </tr>
        <tr>
          <th style="font-size: 6.5pt;">Lec/Lab</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td align="center"><b>CC 101</b></td>
          <td align="left" style="padding-left: 3pt;">Introduction to Computing</td>
          <td align="center">3</td>
          <td align="center">2/3</td>
          <td align="center">BSCS 1A</td>
          <td align="center">40</td>
        </tr>
        <tr>
          <td align="center"><b>CS 108</b></td>
          <td align="left" style="padding-left: 3pt;">Human Computer Interaction</td>
          <td align="center">3</td>
          <td align="center">3</td>
          <td align="center">BSCS 2A</td>
          <td align="center">34</td>
        </tr>
        <tr style="background:#fafafa; font-weight:bold;">
          <td colspan="2" align="right" style="padding-right: 6pt;">TOTAL:</td>
          <td align="center">6</td>
          <td align="center">8</td>
          <td colspan="2"></td>
        </tr>
        <tr>
          <td colspan="6" align="left" style="padding-left: 3pt; font-weight: bold; font-size: 6.5pt;">Other Assignments:</td>
        </tr>
        <tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td></tr>
      </tbody>
    </table>

    <!-- Weekly Timetable Grid (525pt: 89 + 87 + 87 + 91 + 88 + 83) -->
    <p style="font-size: 7.5pt; font-weight: bold; margin: 3pt 0 1pt 0;">Class Schedule:</p>
    <table class="fw-table">
      <colgroup>
        <col width="89" style="width: 89pt;">
        <col width="87" style="width: 87pt;">
        <col width="87" style="width: 87pt;">
        <col width="91" style="width: 91pt;">
        <col width="88" style="width: 88pt;">
        <col width="83" style="width: 83pt;">
      </colgroup>
      <thead>
        <tr>
          <th>TIME</th>
          <th>MONDAY</th>
          <th>TUESDAY</th>
          <th>WEDNESDAY</th>
          <th>THURSDAY</th>
          <th>FRIDAY</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td align="center" style="font-weight: bold; font-size: 6.5pt;">7:00 – 8:30</td>
          <td align="center"><b>CC 101</b><br><span style="font-size:6pt;">RM 204 - BSCS 1A</span></td>
          <td></td>
          <td align="center"><b>CC 101</b><br><span style="font-size:6pt;">RM 204 - BSCS 1A</span></td>
          <td></td>
          <td></td>
        </tr>
        <tr>
          <td align="center" style="font-weight: bold; font-size: 6.5pt;">8:30 – 10:00</td>
          <td></td>
          <td align="center"><b>CS 108</b><br><span style="font-size:6pt;">NB 04 - BSCS 2A</span></td>
          <td></td>
          <td align="center"><b>CS 108</b><br><span style="font-size:6pt;">NB 04 - BSCS 2A</span></td>
          <td></td>
        </tr>
      </tbody>
    </table>

    <!-- Official Signatures (525pt: 265 + 260) -->
    <table class="sig-table">
      <colgroup>
        <col width="265" style="width: 265pt;">
        <col width="260" style="width: 260pt;">
      </colgroup>
      <tr>
        <td style="text-align: left; vertical-align: top;">
          <div style="font-size: 7.5pt;">Prepared by:</div>
          <div style="height: 14pt;"></div>
          <div style="font-size: 8pt; font-weight: bold;"><u>JELLY L. PAREDES, EdD</u></div>
          <div style="font-size: 7pt; color: #333;">Program Chairperson</div>
          
          <div style="height: 8pt;"></div>
          <div style="font-size: 7.5pt;">Approved:</div>
          <div style="height: 14pt;"></div>
          <div style="font-size: 8pt; font-weight: bold;"><u>RAMY LLOYD L. LOTILLA, EdD</u></div>
          <div style="font-size: 7pt; color: #333;">Satellite College Director</div>
        </td>
        <td style="text-align: left; vertical-align: top; padding-left: 20pt;">
          <div style="font-size: 7.5pt;">Conforme:</div>
          <div style="height: 14pt;"></div>
          <div style="font-size: 8pt; font-weight: bold;"><u>PROF. SAMPLE FACULTY</u></div>
          <div style="font-size: 7pt; color: #333;">Faculty</div>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>