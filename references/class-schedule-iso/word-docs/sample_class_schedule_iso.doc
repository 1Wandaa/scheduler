    </table>

    <!-- Signatures -->
    <table class="sig-table">
      <tr>
        <td width="50%">
          Prepared by:<br><br><br>
          <b><u>PROF. PROGRAM CHAIR</u></b><br>
          Program Chair
        </td>
        <td width="50%" align="right">
          Approved:<br><br><br>
          <b><u>RAMY LLOYD LOTILLA, EdD</u></b><br>
