rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  Helper Functions
    // ═══════════════════════════════════════════════════════════════

    // Check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the user's profile document from the 'users' collection.
    // User docs are stored with auth UID as the document ID.
    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if the user has an Admin or Department Head role.
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserProfile().role in ['Admin', 'Department Head'];
    }

    // ═══════════════════════════════════════════════════════════════
    //  Collection Rules
    // ═══════════════════════════════════════════════════════════════

    // --- META (settings, seed version) ---
    match /meta/{docId} {
      allow read: if isAuthenticated();
      // Only admins can write meta documents (settings, seedVersion, etc.)
      allow write: if isAdmin();
    }

    // --- USERS ---
    match /users/{userId} {
      // Allow reading user profiles for login and registration verification
      allow read: if true;

      // Users can create their own profile (sign-up flow) — doc ID must match auth UID and role must be valid
      allow create: if isAuthenticated() && userId == request.auth.uid
        && request.resource.data.role in ['Admin', 'Department Head', 'Faculty', 'Student', 'User'];

      // Users can update their own profile, but NOT their role field (nor hijack an existing username)
      allow update: if (isAuthenticated() && userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username'])
            || !('username' in resource.data)
            || resource.data.username == ''
            || request.resource.data.username == resource.data.username))
        || (isAuthenticated()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password'])
            && !('password' in request.resource.data));

      // Admins can create, update, and delete any user profile
      allow create, update, delete: if isAdmin();
    }

    // --- ROOMS ---
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // --- PROFESSORS (Faculty) ---
    match /professors/{profId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserProfile().role == 'Faculty' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['freeTimeActivities'])
      );
    }

    // --- SUBJECTS ---
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // --- SECTIONS ---
    match /sections/{sectionId} {
      // Allow reading sections during student sign-up dropdown population
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- SCHEDULES ---
    match /schedules/{scheduleId} {
      // All authenticated users can read schedules (students view them)
      allow read: if isAuthenticated();

      // Only admins can create, update, or delete schedules
      allow create, update, delete: if isAdmin();
    }

    // --- SCHEDULE HISTORY ---
    match /scheduleHistory/{historyId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // History entries should not be modified
      allow update: if false;
    }

    // --- DEPARTMENTS ---
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // --- COURSES ---
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // --- TRASH (Recycle Bin) ---
    match /trash/{trashId} {
      allow read, create, update, delete: if isAdmin();
    }

    // --- ACTIVITY LOGS ---
    match /activityLogs/{logId} {
      allow read, delete: if isAdmin();
      // Any authenticated user can create log entries (login/view events) with valid schema
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['username', 'userRole', 'action', 'details', 'meta', 'timestamp'])
        && request.resource.data.action is string;
      // Logs should not be modified
      allow update: if false;
    }

    // --- DEFAULT DENY ---
    // Any collection not explicitly matched above is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
